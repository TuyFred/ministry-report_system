# Production Environment Variables for cPanel
# IMPORTANT: Update these values with your actual cPanel credentials

# Database Configuration (cPanel MySQL)
DB_DIALECT=mysql
DB_NAME=your_cpanel_username_report
DB_USER=your_cpanel_username_dbuser
DB_PASS=your_database_password
DB_HOST=localhost
DB_PORT=3306

# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Secret (Generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# Admin Secret Key (Generate a strong random string)
ADMIN_SECRET_KEY=your_admin_secret_key_here_change_this_in_production

# Client URL (Your frontend domain)
CLIENT_URL=https://report.gnitafrica.com

# Upload Directory (Absolute path on cPanel)
UPLOAD_DIR=/home/your_cpanel_username/ministry-backend/uploads

# Brevo Transactional Email (configure these in the production environment)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Ministry Reports
BREVO_WEBHOOK_SECRET=generate_a_third_long_random_secret
OTP_HASH_SECRET=generate_a_fourth_long_random_secret
APP_NAME=Ministry Reports
